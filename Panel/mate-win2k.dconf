# Painel Windows 2000 para o MATE (dconf de /org/mate/panel/).
# Barra embaixo: MintMenu ("Iniciar"), separador, Mostrar área de trabalho, Inicialização
# rápida (Caja, Firefox, Pluma, Calculadora, Terminal), separador, lista de janelas e, à
# direita, área de notificação, notificações e relógio.
# Carregado pelo instalador (componente mate-panel) com: dconf load /org/mate/panel/ < arquivo

[general]
object-id-list=['clock', 'object-1', 'object-0', 'object-2', 'object-3', 'object-4', 'object-6', 'object-7', 'object-8', 'object-5', 'object-10', 'object-9', 'object-11']
show-program-list=true
toplevel-id-list=['top']

[menubar]
icon-size='default'
item-icon-size='default'
show-desktop=true
show-places=true

[objects/clock]
applet-iid='ClockAppletFactory::ClockApplet'
locked=true
object-type='applet'
panel-right-stick=true
position=0
toplevel-id='top'

[objects/clock/prefs]
expand-locations=false
show-date=false
show-seconds=false
show-temperature=false
show-weather=false

[objects/object-0]
applet-iid='WnckletFactory::WindowListApplet'
locked=true
object-type='applet'
panel-right-stick=false
position=305
toplevel-id='top'

[objects/object-0/prefs]
display-all-workspaces=false
middle-click-close=false
scroll-enabled=false
show-window-thumbnails=false

[objects/object-1]
applet-iid='MintMenuAppletFactory::MintMenuApplet'
locked=true
object-type='applet'
panel-right-stick=false
position=0
toplevel-id='top'

[objects/object-10]
locked=true
object-type='separator'
panel-right-stick=false
position=295
toplevel-id='top'

[objects/object-11]
applet-iid='MateNotificationAppletFactory::MateNotificationApplet'
locked=true
object-type='applet'
panel-right-stick=true
position=1
toplevel-id='top'

[objects/object-2]
applet-iid='WnckletFactory::ShowDesktopApplet'
locked=true
object-type='applet'
panel-right-stick=false
position=105
toplevel-id='top'

[objects/object-3]
launcher-location='/usr/share/applications/caja-browser.desktop'
locked=true
object-type='launcher'
panel-right-stick=false
position=136
toplevel-id='top'

[objects/object-4]
launcher-location='/usr/share/applications/firefox.desktop'
locked=true
object-type='launcher'
panel-right-stick=false
position=166
toplevel-id='top'

[objects/object-5]
launcher-location='/usr/share/applications/pluma.desktop'
locked=true
object-type='launcher'
panel-right-stick=false
position=196
toplevel-id='top'

[objects/object-6]
launcher-location='/usr/share/applications/mate-calc.desktop'
locked=true
object-type='launcher'
panel-right-stick=false
position=229
toplevel-id='top'

[objects/object-7]
launcher-location='/usr/share/applications/mate-terminal.desktop'
locked=true
object-type='launcher'
panel-right-stick=false
position=261
toplevel-id='top'

[objects/object-8]
locked=true
object-type='separator'
panel-right-stick=false
position=88
toplevel-id='top'

[objects/object-9]
applet-iid='NotificationAreaAppletFactory::NotificationArea'
locked=true
object-type='applet'
panel-right-stick=true
position=2
toplevel-id='top'

[objects/object-9/prefs]
min-icon-size=16

[toplevels/top]
enable-buttons=false
expand=true
orientation='bottom'
screen=0
size=28
y-bottom=0
